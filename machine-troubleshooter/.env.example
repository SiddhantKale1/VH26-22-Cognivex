# Qdrant Configuration
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=machine_manuals

# Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Upload Settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/manuals

# Retrieval
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# FastAPI
APP_HOST=0.0.0.0
APP_PORT=8000
